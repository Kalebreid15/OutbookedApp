@page
@model EventsModel

@functions {
    public string GetBadgeClass(string status) => status switch
    {
        "Lead" => "bg-info",
        "Pending" => "bg-warning",
        "Confirmed" => "bg-success",
        "Cancelled" => "bg-danger",
        "Synced" => "bg-primary",
        _ => "bg-secondary"
    };
}

@{
    ViewData["Title"] = "All Events";
}

<!-- 🗓️ Header with Sync Button -->
<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
    <h2>Upcoming Events</h2>

    <form method="post" asp-page-handler="SyncOutlook">
        <button type="submit" class="btn btn-outline-secondary">Sync Outlook</button>
    </form>
</div>

<a asp-page="/CreateEvent" class="btn btn-success mb-3">+ Add New Event</a>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Client</th>
            <th>Location</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var evt in Model.AllEvents)
        {
            <tr>
                <td>@evt.ClientName</td>
                <td>@evt.Location</td>
                <td>@evt.StartTime.ToString("g")</td>
                <td>@evt.EndTime.ToString("g")</td>
                <td>
                    <span class="badge @GetBadgeClass(evt.Status)">@evt.Status</span>
                </td>
                <td>
                    <a asp-page="/EditEvent" asp-route-id="@evt.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-page="/DeleteEvent" asp-route-id="@evt.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        window.onload = function () {
            var msg = '@TempData["ToastMessage"]';
            if (msg) showToast(msg);
        };

        function showToast(message) {
            const toast = document.createElement("div");
            toast.innerHTML = message;
            toast.style.cssText = `
                position: fixed;
                bottom: 20px;
                right: 20px;
                background: #333;
                color: #fff;
                padding: 12px 20px;
                border-radius: 5px;
                z-index: 9999;
                font-size: 14px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }
    </script>
}