@page "{id:guid}"
@model DeleteEventModel

<h2>Delete Event</h2>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this event?</strong>
</div>

<form method="post">
    <!-- Hidden ID input for POST binding -->
    <input type="hidden" asp-for="TargetEvent.Id" />
    <input type="hidden" asp-for="TargetEvent.ClientName" />
    <input type="hidden" asp-for="TargetEvent.Location" />
    <input type="hidden" asp-for="TargetEvent.StartTime" />
    <input type="hidden" asp-for="TargetEvent.EndTime" />

    <div class="mb-3">
        <strong>Client:</strong> @(Model.TargetEvent?.ClientName ?? "N/A")
    </div>
    <div class="mb-3">
        <strong>Location:</strong> @(Model.TargetEvent?.Location ?? "N/A")
    </div>
    <div class="mb-3">
        <strong>Start Time:</strong> @(Model.TargetEvent?.StartTime.ToString("g") ?? "N/A")
    </div>
    <div class="mb-3">
        <strong>End Time:</strong> @(Model.TargetEvent?.EndTime.ToString("g") ?? "N/A")
    </div>
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/Events" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        window.onload = function () {
            var msg = '@TempData["ToastMessage"]';
            if (msg) showToast(msg);
        };

        function showToast(message) {
            const toast = document.createElement("div");
            toast.innerHTML = message;
            toast.style.cssText = `
                position: fixed;
                bottom: 20px;
                right: 20px;
                background: #333;
                color: #fff;
                padding: 12px 20px;
                border-radius: 5px;
                z-index: 9999;
                font-size: 14px;
                box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }
    </script>
}