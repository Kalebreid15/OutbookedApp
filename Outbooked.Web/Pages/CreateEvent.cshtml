@page
@model Outbooked.Web.Pages.CreateEventModel
@{
    ViewData["Title"] = "Create Event";
}

<h2>Create a New Booking</h2>

<form method="post" class="event-form" style="max-width: 600px; margin-top: 20px;">
    <div class="form-group" style="margin-bottom: 15px;">
        <label asp-for="NewEvent.ClientName" class="form-label">Company Name</label>
        <input asp-for="NewEvent.ClientName" class="form-control" placeholder="e.g. Founding Farmers" />
        <span asp-validation-for="NewEvent.ClientName" class="text-danger"></span>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label asp-for="NewEvent.Location" class="form-label">Location</label>
        <input asp-for="NewEvent.Location" class="form-control" placeholder="e.g. Main Hall or Rooftop" />
        <span asp-validation-for="NewEvent.Location" class="text-danger"></span>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label asp-for="NewEvent.StartTime" class="form-label">Start Time</label>
        <input asp-for="NewEvent.StartTime"
               class="form-control"
               type="datetime-local"
               value="@((Model.NewEvent?.StartTime != null)
                                                                                      ? Model.NewEvent.StartTime.ToString("yyyy-MM-ddTHH:mm")
                                                                                      : string.Empty)" />

        <span asp-validation-for="NewEvent.StartTime" class="text-danger"></span>
    </div>

    <div class="form-group" style="margin-bottom: 15px;">
        <label asp-for="NewEvent.EndTime" class="form-label">End Time</label>
        <input asp-for="NewEvent.EndTime"
               class="form-control"
               type="datetime-local"
               value="@((Model.NewEvent?.EndTime != null)
                                                                                      ? Model.NewEvent.EndTime.ToString("yyyy-MM-ddTHH:mm")
                                                                                      : string.Empty)" />

        <span asp-validation-for="NewEvent.EndTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create Event</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.onload = function () {
            var successMsg = '@TempData["ToastMessage"]';
            var errorMsg = '@TempData["ToastError"]';

            if (successMsg) showToast(successMsg);
            if (errorMsg) showToast(errorMsg);
        };
    </script>
}


